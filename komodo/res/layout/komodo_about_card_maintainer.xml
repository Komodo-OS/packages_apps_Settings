<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_single_background_ripple"
    android:layout_marginHorizontal="@dimen/komodo_cardview_padding"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="fill_parent"
        android:layout_marginVertical="@dimen/komodo_pref_vert"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/komodo_margin_start"
            android:text="􀐪"
            style="@style/komodo_about_icon" />

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@android:id/title"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:maxLines="1"
                style="@style/komodo_about_cardview_text_primary" />

            <TextView
                android:id="@android:id/summary"
                android:ellipsize="marquee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/komodo_minus_summary"
                android:maxLines="1"
                style="@style/komodo_about_cardview_text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>